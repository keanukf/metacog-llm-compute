# Copy to .env and set values. Do not commit .env.
# Used by: dashboard (Streamlit), Docker Compose, and all scripts that use --infra-config.
# Single source for MinIO/MLflow credentials.

# Home lab MLflow + MinIO (NPM: mlflow.home, minio.home)
MLFLOW_TRACKING_URI=http://mlflow.home
MLFLOW_S3_ENDPOINT_URL=http://minio.home

# MinIO credentials (same as on the server where MinIO runs)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: bucket name (default: mlflow)
# MINIO_BUCKET=mlflow
