# Dashboard runs locally and talks to MLflow + MinIO on your home server.
# Copy to .env and fill in values (do not commit .env).
# Same credentials as infra/.env on the server.

# Home server (replace with your LAN IP or hostname)
MLFLOW_TRACKING_URI=http://<HOME_SERVER_IP>:5000
MLFLOW_S3_ENDPOINT_URL=http://<HOME_SERVER_IP>:9000

# MinIO credentials (same as MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in server .env)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: bucket name (default: metacog-experiments)
# MINIO_BUCKET=metacog-experiments
