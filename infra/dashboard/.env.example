# Dashboard runs locally and talks to MLflow + MinIO on your home server.
# Copy to .env and fill in values (do not commit .env).
# Same credentials as infra/.env on the server.
# Services are reached via Nginx Proxy Manager DNS: mlflow.home, minio.home.

# Home lab (defaults in code: http://mlflow.home, http://minio.home)
MLFLOW_TRACKING_URI=http://mlflow.home
MLFLOW_S3_ENDPOINT_URL=http://minio.home

# MinIO credentials (same as MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in server .env)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: bucket name (default: mlflow)
# MINIO_BUCKET=mlflow
