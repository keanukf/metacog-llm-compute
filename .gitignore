*.egg-info/
.coverage
htmlcov/

# Env and IDE
.cursor/
.cursorrules
.venv/
venv/
.env
.idea/
*.swp
*.swo

# Claude Code local context (agent working notes, not shared project docs)
CLAUDE.md
CLAUDE.local.md
.claude/

# Results
data/results/

# Scratch space for experiments and testing
/scratch/

