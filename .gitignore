# Bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# Generated data (keep .gitkeep)
data/results/*.json
data/results_smoke_mock/*.json
data/tasks/*
!data/results/.gitkeep
!data/tasks/.gitkeep

# Package / test artifacts (local only)
*.egg-info/
.coverage
htmlcov/

# Env and IDE
.cursor/
.cursorrules
.venv/
venv/
.env
.idea/
*.swp
*.swo

# Results
data/results/
