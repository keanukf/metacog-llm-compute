# Copy to .env (not committed) and fill values.
# Scripts load .env with override=True so these values win over empty LANGFUSE_* / LM_STUDIO_* in the shell/IDE.
#
# Local LM Studio (optional):
# LM_STUDIO_BASE_URL="http://localhost:1234/v1"
# LM_STUDIO_API_KEY="lm-studio"
#
# Langfuse (optional):
# LANGFUSE_PUBLIC_KEY="pk-lf-..."
# LANGFUSE_SECRET_KEY="sk-lf-..."
# LANGFUSE_HOST="https://cloud.langfuse.com"   # or EU: https://eu.cloud.langfuse.com

